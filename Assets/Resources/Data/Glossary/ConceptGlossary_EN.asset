%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed7d7b33cc88b5a458b10c8c0df737a2, type: 3}
  m_Name: ConceptGlossary_EN
  m_EditorClassIdentifier: Assembly-CSharp::ALWTTT.Data.ConceptGlossarySO
  languageCode: en
  numberCulture: 
  entries:
  - id: gig
    displayName: Gig
    description: A sequence of songs played to one audience. Won when every audience
      member is convinced; lost if the last song ends with someone unconvinced or
      Cohesion reaches zero.
  - id: song
    displayName: Song
    description: One piece of a gig, built from cards and played in loops. When it
      ends, its Hype converts into Vibe damage on the audience.
  - id: loop
    displayName: Loop
    description: One repetition of the song and one play period for the player. A
      song lasts a fixed number of loops.
  - id: period
    displayName: Play period
    description: 'The span in which each musician''s play budget applies: the preparation
      before Play, then each loop.'
  - id: play
    displayName: Play
    description: The button that starts the song. Cards played after it take effect
      in the running song without stopping it.
  - id: track
    displayName: Track
    description: A musician's line in the song panel. Holds one active composition
      card at a time; a new card replaces the old one.
  - id: song_end
    displayName: Song end
    description: The moment the last loop finishes. Hype converts into Vibe damage,
      banked stage bonuses are paid, and the win condition is checked.
  - id: stage
    displayName: Stage effects
    description: Visual intensity levels tied to Hype thresholds. Each upward crossing
      banks a flat Vibe bonus paid at song end. Higher levels unlock as run rewards.
  - id: budget
    displayName: Play budget
    description: Per period, each musician may play one composition card and one
      action card. Unspent plays do not carry over.
  - id: composition_card
    displayName: Composition card
    description: Adds music to the song. Played onto the band; resolves on the musician
      named on the card and writes to that musician's track.
  - id: action_card
    displayName: Action card
    description: Changes meters or statuses. Played onto a musician or an audience
      member; takes effect immediately and does not change the song.
  - id: sound_card
    displayName: Sound card
    description: A composition card that changes a property of the whole song, such
      as tempo or key, instead of adding a part. Changes no meter by itself.
  - id: hype
    displayName: Hype
    description: The song's accumulated intensity. At song end it converts into Vibe
      damage on every audience member; crossing thresholds steps up the stage effects.
  - id: inspiration
    displayName: Inspiration
    description: The resource that pays for cards. Granted at the end of each loop.
      A card with a cost cannot be played without it.
  - id: cohesion
    displayName: Cohesion
    description: The band's shared endurance. Loses one point each time a musician
      breaks down, and more when a gig is lost. At zero, the band splits up and the
      tour ends.
  - id: breakdown
    displayName: Breakdown
    description: 'What happens when a musician''s Grit reaches zero: the band loses
      one <link=cohesion>Cohesion</link> and the musician recovers part of their
      Grit, but is left <link=exposed>Exposed</link>.'
  - id: blocked
    displayName: Blocked
    description: 'An audience member standing at the front is Blocked: it receives
      no <link=vibe>Vibe</link> from cards or from song end. Positional, recomputed
      whenever the audience reorders.'
  - id: captivated
    displayName: Captivated
    description: Locked in. Incoming <link=vibe>Vibe</link> hits +25% harder per
      stack.
  - id: choke
    displayName: Choke
    description: Forces additional card discards at turn start. Loses 1 stack per
      turn.
  - id: composure
    displayName: Composure
    description: Absorbs incoming <link=stress>Stress</link> before it lands. Clears
      at the start of each Player Turn.
  - id: earworm
    displayName: Earworm
    description: This audience member has the song stuck in their head (+N <link=vibe>Vibe</link>
      per audience turn, loses 1 stack per turn).
  - id: exposed
    displayName: Exposed
    description: Each stack adds +25% to incoming <link=stress>Stress</link> multipliers.
  - id: feedback
    displayName: Feedback
    description: Damage over time at the start of each Player Turn. Lasts until cleared.
  - id: flow
    displayName: Flow
    description: Each stack adds +1 to any positive <link=vibe>Vibe</link> gain from
      cards and song resolution.
  - id: hyped
    displayName: Hyped
    description: The crowd is riled up. Each stack adds +1 to <link=stress>Stress</link>
      dealt by this audience member; loses 1 stack per Player Turn.
  - id: indifference
    displayName: Indifference
    description: Inmune to vibe.
  - id: shaken
    displayName: Shaken
    description: Applied when a musician <link=breakdown>breaks down</link>. Lasts
      one full song cycle.
  - id: spotlight
    displayName: Spotlight
    description: The audience only has eyes for C2. During their next turn, their
      targeted attacks go to C2.
  - id: voltage
    displayName: Voltage
    description: 'Stored charge. Does nothing on its own: it gets spent.'
  - id: stress
    displayName: Stress
    description: 'The damage a musician takes: it lowers their Grit. When Grit reaches
      zero, <link=breakdown>Breakdown</link>.'
  - id: vibe
    displayName: Vibe
    description: Fill to win over Audience Members.
  - id: convinced
    displayName: Convinced
    description: Is vibing with the music. Doesn't act anymore.
  - id: tall
    displayName: Tall
    description: Blocks the view of all non-tall character behind them.
  - id: consume
    displayName: Consume
    description: Removed from your deck after playing. Gone for the rest of this
      gig.
  - id: ethereal
    displayName: Ethereal
    description: If not played this turn, removed from deck.
  - id: exhaust
    displayName: Exhaust
    description: Can only be played once per encounter. Moves to exhaust pile after
      use.
  - id: ab_block_the_view
    displayName: Block the View
    description: Pushes his way toward the front. Anyone shorter left behind him
      is <link=blocked>Blocked</link> and takes no <link=vibe>Vibe</link>.
  - id: ab_egg_him_on
    displayName: Go On, Boss!
    description: 'Winds up their <link=leader>Boss</link>: they gain <link=hyped>Hyped</link>
      and their <link=stress>Stress</link> hits harder. If the boss is already <link=convinced>Convinced</link>,
      nothing happens.'
  - id: ab_heckle
    displayName: Heckle
    description: 'Picks on one bandmate: leaves them <link=exposed>Exposed</link>,
      then piles on the <link=stress>Stress</link>.'
  - id: ab_indifference
    displayName: Indifference
    description: 'Tunes the band out. Gains <link=indifference>Indifference</link>:
      no <link=vibe>Vibe</link> gets through to him while it lasts.'
  - id: ab_scathing_review
    displayName: Scathing Review
    description: Posts a brutal takedown of one bandmate. Piles on the <link=stress>Stress</link>.
  - id: ab_tantrum
    displayName: Tantrum
    description: Screams the place down. Deals <link=stress>Stress</link> to the
      bandmates it marks.
  - id: ab_total_indifference
    displayName: Total Indifference
    description: Doesn't even blink. That blank stare deals <link=stress>Stress</link>
      to one bandmate.
  - id: role_rhythm
    displayName: Rhythm
    description: The percussion track. It sets the pulse everything else plays against.
  - id: role_backing
    displayName: Backing
    description: The chord track underneath. It states the harmony the other parts
      move over.
  - id: role_bassline
    displayName: Bassline
    description: The low line. It ties the chords to the rhythm and anchors the song's
      bottom end.
  - id: role_melody
    displayName: Melody
    description: The main tune. It is the line an audience remembers and hums back.
  - id: role_harmony
    displayName: Harmony
    description: Secondary voices that move with the melody and thicken it.
  - id: role_lead
    displayName: Lead
    description: The spotlight line. It plays over everything else and takes the
      foreground.
  - id: scope_trackonly
    displayName: Track only
    description: Affects one musician's track. The rest of the song is untouched.
  - id: scope_currentpart
    displayName: Current part
    description: Affects the part playing right now. It stops when the part does.
  - id: scope_nextpart
    displayName: Next part
    description: Affects the part that comes after this one. Nothing changes until
      then.
  - id: scope_wholesong
    displayName: Whole song
    description: Affects the whole song from here on. It outlives the part you played
      it in.
  - id: timing_immediate
    displayName: Immediately
    description: Takes effect the moment the card is played.
  - id: timing_onnextloop
    displayName: Next loop
    description: Takes effect when the current loop ends and the next one starts.
  - id: timing_onnextpartstart
    displayName: Next part start
    description: Waits for the current part to finish and takes effect when the next
      one begins.
  - id: mod_meter
    displayName: Meter
    description: How many beats fit in a bar. Changing it changes the shape of the
      groove.
  - id: mod_tempo
    displayName: Tempo
    description: How fast the song runs. Faster raises the energy; slower gives each
      note room.
  - id: mod_key
    displayName: Key
    description: The note the song is centred on. Moving it lifts or drops everything
      at once.
  - id: mod_instrument
    displayName: Instrument
    description: Which instrument plays this track. It changes the timbre, not the
      notes.
  - id: mod_tonality
    displayName: Mode
    description: The scale colour the song uses. It decides whether a passage reads
      bright or dark.
  - id: cardtype_chr
    displayName: Charisma
    description: Presence and poise. Charisma cards hold the band together and shrug
      off the crowd's heat.
  - id: cardtype_tch
    displayName: Technique
    description: Skill and precision. Technique cards bend tempo, timing and the
      shape of the song.
  - id: cardtype_emt
    displayName: Emotion
    description: Feeling and intensity. Emotion cards move the crowd directly.
  - id: cardtype_sfx
    displayName: Sound FX
    description: Pedals, noise and texture. Sound FX cards change how the song hits.
  - id: cardtype_songmod
    displayName: Song Mod
    description: A legacy card type that alters the song itself.
  - id: partaction_createpart
    displayName: New part
    description: Adds a new part at the end of the song. The band keeps what it was
      playing.
  - id: partaction_markintro
    displayName: Intro
    description: 'Marks this part as the intro: a lead-in before the song proper.'
  - id: partaction_marksolo
    displayName: Solo
    description: Gives one musician the floor for this part.
  - id: partaction_markoutro
    displayName: Outro
    description: 'Marks this part as the outro: the song winds down here.'
  - id: partaction_markbridge
    displayName: Bridge
    description: 'Adds a bridge: a new part that breaks the pattern before returning.'
  - id: partaction_markfinal
    displayName: Final part
    description: Marks this part as the last one. The song ends after it.
  - id: partaction_custom
    displayName: Custom part
    description: A part with its own label.
  - id: leader
    displayName: Boss
    description: Runs their crew. The minions cheer them on; win the boss over and
      they have no one left to cheer.
  - id: ab_croak
    displayName: Croak
    description: Croaks over the song. Deals <link=stress>Stress</link> to one bandmate.
      If its partner croaks at the same one, it hits twice as hard.
  - id: ab_cut_in
    displayName: Cut In
    description: Pushes to the front. Anyone shorter left behind is <link=blocked>Blocked</link>
      and gets no <link=vibe>Vibe</link>.
  - id: ab_elbow
    displayName: Elbow
    description: Now at the front, it leans on the stage. Deals <link=stress>Stress</link>
      to one bandmate.
  - id: ab_count_one
    displayName: "One\u2026"
    description: 'Starts counting. It swells up: gains <link=hyped>Hyped</link>.
      On three, it strikes.'
  - id: ab_count_two
    displayName: "Two\u2026"
    description: 'Keeps counting and swells further: gains <link=hyped>Hyped</link>.
      Three comes next.'
  - id: ab_count_three
    displayName: THREE!
    description: 'Lets it all out on one bandmate: heavy <link=stress>Stress</link>,
      plus its <link=hyped>Hyped</link>.'
  - id: ab_boo
    displayName: BOOO!
    description: Boos one bandmate from the gut. Deals <link=stress>Stress</link>;
      hits harder while <link=hyped>Hyped</link>.
  - id: ab_egg_one
    displayName: First Egg
    description: Lays an egg. Regains <link=vibe>Vibe</link> and gains <link=hyped>Hyped</link>.
      On the third turn, the eggs hatch on the whole band.
  - id: ab_egg_two
    displayName: Second Egg
    description: Lays an egg. Regains <link=vibe>Vibe</link> and gains <link=hyped>Hyped</link>.
      On the third turn, the eggs hatch on the whole band.
  - id: ab_hatch
    displayName: Hatch!
    description: 'The eggs burst: deals <link=stress>Stress</link> to the whole band,
      plus its <link=hyped>Hyped</link>.'
