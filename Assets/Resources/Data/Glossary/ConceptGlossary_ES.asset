%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ed7d7b33cc88b5a458b10c8c0df737a2, type: 3}
  m_Name: ConceptGlossary_ES
  m_EditorClassIdentifier: Assembly-CSharp::ALWTTT.Data.ConceptGlossarySO
  languageCode: es
  numberCulture: es-ES
  entries:
  - id: gig
    displayName: Concierto
    description: "Secuencia de canciones tocadas ante un p\xFAblico. Se gana al convencer
      a todo el p\xFAblico; se pierde si la \xFAltima canci\xF3n acaba con alguien
      sin convencer o la Cohesi\xF3n llega a cero."
  - id: song
    displayName: "Canci\xF3n"
    description: "Una pieza del concierto, construida con cartas y tocada en loops.
      Al acabar, su Hype se convierte en da\xF1o de Vibe al p\xFAblico."
  - id: loop
    displayName: Loop
    description: "Una repetici\xF3n de la canci\xF3n y un periodo de juego para el
      jugador. Una canci\xF3n dura un n\xFAmero fijo de loops."
  - id: period
    displayName: Periodo de juego
    description: "Tramo en que se aplica el presupuesto de jugadas de cada m\xFAsico:
      la preparaci\xF3n antes de Play y despu\xE9s cada loop."
  - id: play
    displayName: Play
    description: "El bot\xF3n que inicia la canci\xF3n. Las cartas jugadas despu\xE9s
      surten efecto en la canci\xF3n en marcha sin detenerla."
  - id: track
    displayName: Pista
    description: "La l\xEDnea de un m\xFAsico en el panel de la canci\xF3n. Contiene
      una carta de composici\xF3n activa a la vez; una nueva sustituye a la anterior."
  - id: song_end
    displayName: "Final de la canci\xF3n"
    description: "El momento en que termina el \xFAltimo loop. El Hype se convierte
      en da\xF1o de Vibe, se pagan los bonos del escenario y se comprueba la victoria."
  - id: stage
    displayName: Efectos del escenario
    description: "Niveles de intensidad visual ligados a umbrales de Hype. Cada cruce
      ascendente acumula un bono fijo de Vibe que se paga al final de la canci\xF3n.
      Los niveles altos se desbloquean como recompensa."
  - id: budget
    displayName: Presupuesto de jugadas
    description: "Por periodo, cada m\xFAsico puede jugar una carta de composici\xF3n
      y una de acci\xF3n. Las jugadas no usadas no se acumulan."
  - id: composition_card
    displayName: "Carta de composici\xF3n"
    description: "A\xF1ade m\xFAsica a la canci\xF3n. Se juega sobre la banda; se
      resuelve sobre el m\xFAsico indicado en la carta y escribe en su pista."
  - id: action_card
    displayName: "Carta de acci\xF3n"
    description: "Cambia medidores o estados. Se juega sobre un m\xFAsico o un miembro
      del p\xFAblico; surte efecto al instante y no cambia la canci\xF3n."
  - id: sound_card
    displayName: Carta de sonido
    description: "Carta de composici\xF3n que cambia una propiedad de toda la canci\xF3n,
      como el tempo o la tonalidad, en lugar de a\xF1adir una parte. Por s\xED sola
      no cambia ning\xFAn medidor."
  - id: hype
    displayName: Hype
    description: "Intensidad acumulada de la canci\xF3n. Al final se convierte en
      da\xF1o de Vibe a todo el p\xFAblico; cruzar umbrales sube los efectos del
      escenario."
  - id: inspiration
    displayName: "Inspiraci\xF3n"
    description: El recurso que paga las cartas. Se concede al final de cada loop.
      Una carta con coste no puede jugarse sin ella.
  - id: cohesion
    displayName: "Cohesi\xF3n"
    description: "La resistencia compartida de la banda. Pierde un punto cada vez
      que un m\xFAsico colapsa, y m\xE1s al perder un gig. A cero, la banda se separa
      y la gira termina."
  - id: breakdown
    displayName: Colapso
    description: "Lo que ocurre cuando el Aguante de un m\xFAsico llega a cero: la banda pierde una <link=cohesion>Cohesi\xF3n</link> y el m\xFAsico recupera parte de su Aguante, pero queda <link=exposed>Expuesto</link>."
  - id: blocked
    displayName: Bloqueado
    description: "Un miembro del p\xFAblico en primera fila est\xE1 Bloqueado: no recibe <link=vibe>Vibe</link> de cartas ni del final de la canci\xF3n. Depende de la posici\xF3n; se recalcula al reordenarse el p\xFAblico."
  - id: captivated
    displayName: Cautivado
    description: "Totalmente entregado. El <link=vibe>Vibe</link> que recibe pega un 25 % m\xE1s fuerte por cada nivel."
  - id: choke
    displayName: Ahogo
    description: Obliga a descartar cartas adicionales al empezar el turno. Pierde
      1 nivel por turno.
  - id: composure
    displayName: Compostura
    description: "Absorbe el <link=stress>Stress</link> entrante antes de que llegue. Se limpia al empezar cada turno del jugador."
  - id: earworm
    displayName: Pegadiza
    description: "Este miembro del p\xFAblico tiene la canci\xF3n metida en la cabeza (+N <link=vibe>Vibe</link> por turno del p\xFAblico; pierde 1 nivel por turno)."
  - id: exposed
    displayName: Expuesto
    description: "Cada nivel a\xF1ade un +25 % a los multiplicadores de <link=stress>Stress</link> entrante."
  - id: feedback
    displayName: Feedback
    description: "Da\xF1o continuado al empezar cada turno del jugador. Dura hasta
      que se limpia."
  - id: flow
    displayName: Flow
    description: "Cada nivel a\xF1ade +1 a cualquier ganancia positiva de <link=vibe>Vibe</link> por cartas y por la resoluci\xF3n de la canci\xF3n."
  - id: hyped
    displayName: Exaltado
    description: "El p\xFAblico se ha venido arriba. Cada nivel a\xF1ade +1 al <link=stress>Stress</link> que inflige este miembro del p\xFAblico; pierde 1 nivel por turno del jugador."
  - id: indifference
    displayName: Indiferencia
    description: Inmune al Vibe.
  - id: shaken
    displayName: Shaken
    description: "Se aplica cuando un m\xFAsico <link=breakdown>colapsa</link>. Dura un ciclo completo de canci\xF3n."
  - id: spotlight
    displayName: Foco
    description: "El p\xFAblico solo tiene ojos para C2. Durante su pr\xF3ximo turno,
      sus ataques dirigidos van a C2."
  - id: voltage
    displayName: Voltaje
    description: "Carga acumulada. No hace nada por s\xED sola: se gasta."
  - id: stress
    displayName: Stress
    description: "El da\xF1o que recibe un m\xFAsico: baja su Aguante. Cuando el Aguante llega a cero, <link=breakdown>Colapso</link>."
  - id: vibe
    displayName: Vibe
    description: "Ll\xE9nalo para convencer a los miembros del p\xFAblico."
  - id: convinced
    displayName: Convencido
    description: "Est\xE1 vibrando con la m\xFAsica. Ya no act\xFAa."
  - id: tall
    displayName: Alto
    description: "Tapa la vista a todos los personajes no altos que tenga detr\xE1s."
  - id: consume
    displayName: Consumir
    description: Se retira de tu mazo tras jugarla. Desaparece durante el resto del
      concierto.
  - id: ethereal
    displayName: "Et\xE9reo"
    description: Si no se juega este turno, se retira del mazo.
  - id: exhaust
    displayName: Agotar
    description: Solo se puede jugar una vez por encuentro. Va a la pila de agotadas
      tras usarse.
  - id: ab_block_the_view
    displayName: Tapar la Vista
    description: "Se abre paso hacia delante. Quien quede detr\xE1s y sea m\xE1s bajo queda <link=blocked>Bloqueado</link> y no recibe <link=vibe>Vibe</link>."
  - id: ab_egg_him_on
    displayName: Darle Cuerda
    description: "Le da cuerda a un espectador <link=tall>Alto</link>: gana <link=hyped>Exaltado</link> y todo el <link=stress>Stress</link> que inflige pega m\xE1s fuerte."
  - id: ab_heckle
    displayName: Abuchear
    description: "Se ceba con un m\xFAsico: lo deja <link=exposed>Expuesto</link> y luego le carga el <link=stress>Stress</link>."
  - id: ab_indifference
    displayName: Indiferencia
    description: "Pasa de la banda. Gana <link=indifference>Indiferencia</link>: mientras dure, no le llega nada de <link=vibe>Vibe</link>."
  - id: ab_scathing_review
    displayName: "Cr\xEDtica Mordaz"
    description: "Publica una cr\xEDtica demoledora contra un m\xFAsico. Le carga mucho <link=stress>Stress</link>."
  - id: ab_tantrum
    displayName: Rabieta
    description: "Se pone a berrear. Carga <link=stress>Stress</link> a los m\xFAsicos que marca."
  - id: ab_total_indifference
    displayName: Indiferencia Total
    description: "Ni pesta\xF1ea. Esa cara de nada le carga <link=stress>Stress</link> a un m\xFAsico."
  - id: role_rhythm
    displayName: Ritmo
    description: "La pista de percusi\xF3n. Marca el pulso contra el que toca todo
      lo dem\xE1s."
  - id: role_backing
    displayName: "Acompa\xF1amiento"
    description: "La pista de acordes de fondo. Expone la armon\xEDa sobre la que
      se mueven las dem\xE1s partes."
  - id: role_bassline
    displayName: Bajo
    description: "La l\xEDnea grave. Ata los acordes al ritmo y sostiene la base
      de la canci\xF3n."
  - id: role_melody
    displayName: "Melod\xEDa"
    description: "La l\xEDnea principal. Es la que el p\xFAblico recuerda y tararea."
  - id: role_harmony
    displayName: "Armon\xEDa"
    description: "Voces secundarias que acompa\xF1an a la melod\xEDa y le dan cuerpo."
  - id: role_lead
    displayName: Solista
    description: "La l\xEDnea protagonista. Toca por encima del resto y se lleva
      el primer plano."
  - id: scope_trackonly
    displayName: "S\xF3lo esta pista"
    description: "Afecta a la pista de un solo m\xFAsico. El resto de la canci\xF3n
      no cambia."
  - id: scope_currentpart
    displayName: Parte actual
    description: Afecta a la parte que suena ahora. Termina cuando termina esa parte.
  - id: scope_nextpart
    displayName: Parte siguiente
    description: "Afecta a la parte que viene despu\xE9s de \xE9sta. Hasta entonces
      no cambia nada."
  - id: scope_wholesong
    displayName: "Toda la canci\xF3n"
    description: "Afecta a toda la canci\xF3n a partir de aqu\xED. Sobrevive a la
      parte en la que la jugaste."
  - id: timing_immediate
    displayName: Inmediato
    description: Surte efecto en el momento de jugar la carta.
  - id: timing_onnextloop
    displayName: "Pr\xF3ximo bucle"
    description: Surte efecto cuando acaba el bucle actual y empieza el siguiente.
  - id: timing_onnextpartstart
    displayName: "Al empezar la pr\xF3xima parte"
    description: Espera a que acabe la parte actual y surte efecto cuando empieza
      la siguiente.
  - id: mod_meter
    displayName: "Comp\xE1s"
    description: "Cu\xE1ntos pulsos caben en un comp\xE1s. Cambiarlo cambia la forma
      del groove."
  - id: mod_tempo
    displayName: Tempo
    description: "A qu\xE9 velocidad va la canci\xF3n. M\xE1s r\xE1pido sube la energ\xEDa;
      m\xE1s lento da aire a cada nota."
  - id: mod_key
    displayName: Tonalidad
    description: "La nota sobre la que se centra la canci\xF3n. Moverla sube o baja
      todo a la vez."
  - id: mod_instrument
    displayName: Instrumento
    description: "Qu\xE9 instrumento toca esta pista. Cambia el timbre, no las notas."
  - id: mod_tonality
    displayName: Modo
    description: "El color de la escala que usa la canci\xF3n. Decide si un pasaje
      suena luminoso u oscuro."
  - id: cardtype_chr
    displayName: Carisma
    description: "Presencia y aplomo. Las cartas de Carisma mantienen unida a la
      banda y aguantan la presi\xF3n del p\xFAblico."
  - id: cardtype_tch
    displayName: "T\xE9cnica"
    description: "Destreza y precisi\xF3n. Las cartas de T\xE9cnica doblan el tempo,
      el momento y la forma de la canci\xF3n."
  - id: cardtype_emt
    displayName: "Emoci\xF3n"
    description: "Sentimiento e intensidad. Las cartas de Emoci\xF3n mueven al p\xFAblico
      directamente."
  - id: cardtype_sfx
    displayName: Efecto de sonido
    description: "Pedales, ruido y textura. Las cartas de Efecto cambian c\xF3mo
      golpea la canci\xF3n."
  - id: cardtype_songmod
    displayName: "Mod. de canci\xF3n"
    description: "Un tipo de carta heredado que altera la propia canci\xF3n."
  - id: partaction_createpart
    displayName: Parte nueva
    description: "A\xF1ade una parte nueva al final de la canci\xF3n. La banda conserva
      lo que tocaba."
  - id: partaction_markintro
    displayName: Intro
    description: "Marca esta parte como intro: una entrada antes de la canci\xF3n
      en s\xED."
  - id: partaction_marksolo
    displayName: Solo
    description: "Cede el protagonismo a un m\xFAsico durante esta parte."
  - id: partaction_markoutro
    displayName: Outro
    description: "Marca esta parte como outro: la canci\xF3n se apaga aqu\xED."
  - id: partaction_markbridge
    displayName: Puente
    description: "A\xF1ade un puente: una parte nueva que rompe el patr\xF3n antes
      de volver."
  - id: partaction_markfinal
    displayName: Parte final
    description: "Marca esta parte como la \xFAltima. La canci\xF3n termina tras
      ella."
  - id: partaction_custom
    displayName: Parte personalizada
    description: Una parte con etiqueta propia.
